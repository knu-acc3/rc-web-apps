{
  "name": "RC Web App - All-in-One Online Tools & Utilities",
  "short_name": "RC",
  "description": "3,000+ interactive tools, world clock, actual size calibrator, emoji & symbol compendiums, timers, and diagnostics.",
  "start_url": "/ru",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f7f7f8",
  "theme_color": "#0a0c10",
  "orientation": "any",
  "categories": ["utilities", "productivity"],
  "shortcuts": [
    {
      "name": "Search tools",
      "short_name": "Search",
      "url": "/ru?search=1",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Color Picker",
      "short_name": "Colors",
      "url": "/ru/tools/color-picker",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Password Generator",
      "short_name": "Passwords",
      "url": "/ru/tools/password-generator",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "PDF Studio",
      "short_name": "PDF",
      "url": "/ru/tools/pdf-studio",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/ru/tools/json-formatter",
      "name": "JSON File",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }],
      "accept": {
        "application/json": [".json"]
      }
    },
    {
      "action": "/ru/tools/json-csv",
      "name": "CSV File",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }],
      "accept": {
        "text/csv": [".csv"]
      }
    },
    {
      "action": "/ru/tools/svg-editor",
      "name": "SVG Vector Image",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }],
      "accept": {
        "image/svg+xml": [".svg"]
      }
    },
    {
      "action": "/ru/tools/pdf-studio",
      "name": "PDF Document",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }],
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ]
}
