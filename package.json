{
  "name": "rc-web-app",
  "version": "1.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "sync:wasm": "node scripts/sync-wasm-assets.mjs",
    "prebuild": "npm run sync:wasm",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "start:next": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "rebrand": "node scripts/brand-and-domain-replacer.mjs",
    "check:catalog": "node scripts/check-tool-catalog.mjs",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "node scripts/qa/validate-regex-library.mjs && npm run check:catalog",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts tests/e2e/catalog.spec.ts tests/e2e/file-converter.spec.ts",
    "audit:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:browser": "playwright test",
    "audit:routes": "node scripts/qa/run-built-server-audit.mjs",
    "audit:seo": "npm run audit:routes",
    "verify:ci": "npm run lint -- --max-warnings 0 && npm run typecheck && npm run test:unit && npm run test:contracts && npm run build",
    "verify:release": "npm run verify:ci && node scripts/qa/run-built-server-audit.mjs && npm run test:browser",
    "verify": "npm run verify:ci",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "audit:high": "npm audit --audit-level=high",
    "audit:tools": "node scripts/audit-tool-ux.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imagemagick/magick-wasm": "^0.0.43",
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "^22.1.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "heic-to": "^1.5.2",
    "isomorphic-dompurify": "^3.19.0",
    "jszip": "^3.10.2",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "undici": "^8.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^2.0.1",
    "browserslist": "^4.28.7",
    "undici": "^7.28.1"
  }
}
